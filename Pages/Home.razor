@page "/"

<PageTitle>FuzzyScorer — Live Word Cloud Repair</PageTitle>

<div class="demo-header">
    <h1>FuzzyScorer — Live Word Cloud Repair</h1>
    <p class="demo-subtitle">Klastrowanie literówek przez dystans Levenshteina</p>
</div>

<div class="demo-container">
    <div class="input-section">
        <label class="form-label" for="inputText">Tekst źródłowy</label>
        <textarea id="inputText"
                  class="form-control"
                  rows="6"
                  @bind="InputText"
                  @bind:event="oninput"
                  @bind:after="OnInputChanged"></textarea>
    </div>

    <div class="slider-section">
        <label class="form-label">
            Maksymalny dystans edycji: <strong>@maxEditDistance</strong>
        </label>
        <input type="range"
               class="form-range"
               min="0"
               max="@MaxEditDistanceLimit"
               step="1"
               @bind="maxEditDistance"
               @bind:event="oninput"
               @bind:after="OnSliderChanged" />
        <div class="slider-labels">
            <span>0 (tylko dokładne)</span>
            <span>@MaxEditDistanceLimit (bardzo luźne)</span>
        </div>
    </div>

    <div class="split-view">
        <div class="panel panel-left">
            <h2>Surowe dane</h2>
            <p class="panel-subtitle">WordScorer.GetWordFrequencies</p>
            <div class="word-cloud">
                @foreach (var word in rawFrequencies)
                {
                    <span class="word-tag"
                          style="font-size: @WordSize(word.Score, maxRawScore)px; opacity: @WordOpacity(word.Score, maxRawScore)">
                        @word.Text
                        <small>(@word.Score)</small>
                    </span>
                }
            </div>
        </div>

        <div class="panel panel-right">
            <h2>Przetworzone (sklastrowane)</h2>
            <p class="panel-subtitle">WordScorer.GroupSimilarWords (maxEditDistance: @maxEditDistance)</p>
            <div class="word-cloud">
                @foreach (var word in groupedWords)
                {
                    <span class="word-tag grouped"
                          style="font-size: @WordSize(word.Score, maxGroupedScore)px; opacity: @WordOpacity(word.Score, maxGroupedScore)">
                        @word.Text
                        <small>(@word.Score)</small>
                    </span>
                }
            </div>
        </div>
    </div>

    <div class="errors-section">
        <h2>Detected Errors Log</h2>
        <p class="panel-subtitle">
            IFuzzyScorer.ScoreAsync (sensitivity: @(Math.Round(maxEditDistance / (double)MaxEditDistanceLimit, 3)))
        </p>
        @if (errorResult == null || errorResult.Errors.Count == 0)
        {
            <div class="alert alert-info">Brak wykrytych błędów — wszystkie słowa pasują do swoich klastrów.</div>
        }
        else
        {
            <div class="errors-stats">
                <span>Słów oryginalnie: <strong>@errorResult.OriginalSize</strong></span>
                <span>Słów po kompresji: <strong>@errorResult.CompressedSize</strong></span>
                <span>Wykryto literówek: <strong>@errorResult.Errors.Count</strong></span>
            </div>
            <table class="table table-striped errors-table">
                <thead>
                    <tr>
                        <th>Błędny zapis</th>
                        <th>Liczba wystąpień</th>
                        <th>Numery linii</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var error in errorResult.Errors)
                    {
                        <tr>
                            <td>
                                <span class="error-text">@error.ErrorText</span>
                            </td>
                            <td>@error.RepetitionCount</td>
                            <td>@string.Join(", ", error.LineNumbers)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    [Inject]
    private global::FuzzyScorer.IFuzzyScorer Scorer { get; set; } = default!;

    private const int MaxEditDistanceLimit = 50;

    private string InputText { get; set; } = SampleData;
    private int maxEditDistance = 3;

    private List<global::FuzzyScorer.WordScore> rawFrequencies = [];
    private List<global::FuzzyScorer.WordScore> groupedWords = [];
    private global::FuzzyScorer.FuzzyScorerResult? errorResult;

    private double maxRawScore = 1;
    private double maxGroupedScore = 1;

    private const string SampleData =
        """
        Apple aple Apple apple appple
        Banana bananna bannana Banana cherry
        Excellent Excelent excelent Excelleent very good
        Good god goood excellent
        Happy hapy hapiness happiness happy
        Tiger TIGER TlGER tigerr
        """;

    protected override void OnInitialized()
    {
        RecalculateAll();
    }

    private async Task OnInputChanged()
    {
        RecalculateAll();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSliderChanged()
    {
        RecalculateGrouped();
        await RecalculateErrors();
        await InvokeAsync(StateHasChanged);
    }

    private void RecalculateAll()
    {
        RecalculateRaw();
        RecalculateGrouped();
        _ = RecalculateErrors();
    }

    private void RecalculateRaw()
    {
        rawFrequencies = global::FuzzyScorer.WordScorer.GetWordFrequencies(InputText);
        maxRawScore = rawFrequencies.Count > 0
            ? rawFrequencies.Max(w => w.Score)
            : 1;
    }

    private void RecalculateGrouped()
    {
        groupedWords = global::FuzzyScorer.WordScorer.GroupSimilarWords(InputText, maxEditDistance);
        maxGroupedScore = groupedWords.Count > 0
            ? groupedWords.Max(w => w.Score)
            : 1;
    }

    private async Task RecalculateErrors()
    {
        var sensitivity = maxEditDistance / (double)MaxEditDistanceLimit;
        errorResult = await Scorer.ScoreAsync(InputText, sensitivity, CancellationToken.None);
    }

    private static double WordSize(int score, double maxScore)
    {
        const double minFontSize = 14;
        const double maxFontSize = 48;
        if (maxScore <= 0) return minFontSize;
        return minFontSize + (score / maxScore) * (maxFontSize - minFontSize);
    }

    private static double WordOpacity(int score, double maxScore)
    {
        const double minOpacity = 0.45;
        const double maxOpacity = 1.0;
        if (maxScore <= 0) return minOpacity;
        return minOpacity + (score / maxScore) * (maxOpacity - minOpacity);
    }
}
